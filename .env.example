# ==============================================================================
# WANDERLUST AI TRAVEL PLANNER — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to '.env' in this directory and populate with actual credentials.
# NEVER commit the actual '.env' file containing real secrets to version control.

# Node Environment Settings
PORT=5000
NODE_ENV=development

# Allowed CORS Origins (Comma-separated list)
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# LLM Providers Configuration
# 1. Ollama (Local running model)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma:2b

# 2. OpenRouter (Cloud models aggregation)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-2-9b-it:free

# 3. Google Gemini (Cloud native model)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Maps & Places APIs Configuration
# 1. Google Places (Highly recommended for hotel website and photos lookup)
TRAVEL_GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
TRAVEL_GOOGLE_PLACES_LANGUAGE=en
TRAVEL_GOOGLE_PLACES_REGION=IN

# 2. Ola Maps (Route calculations, distance lookup and geocoding)
OLA_MAPS_CLIENT_ID=your_ola_maps_client_id_here
OLA_MAPS_CLIENT_SECRET=your_ola_maps_client_secret_here
OLA_MAPS_AUTH_MODE=client_credentials
